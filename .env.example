EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optionnel — abonnements. Voir docs/abonnements.md.
# Clés publiques RevenueCat (Project settings → API keys), une par store.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Clé « Test Store » RevenueCat : achats simulés sans compte Apple/Google. Lue uniquement en
# développement ; ne jamais la mettre dans l'environnement « production » d'EAS.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY=

# Obligatoires avant soumission App Store / Play Store (liens affichés sur le paywall).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Optionnel — adresse affichée dans Profil → Aide & support.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Où en est la version chez Apple, sans mot de passe ni code 2FA (scripts/app-store.mjs).
# Créés une seule fois dans App Store Connect → Users and Access → Integrations →
# App Store Connect API, rôle App Manager. Le .p8 ne se télécharge qu'une fois.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY=/chemin/vers/AuthKey_XXXXXXXXXX.p8
