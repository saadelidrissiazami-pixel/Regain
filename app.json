{
  "expo": {
    "name": "Regain",
    "slug": "regain",
    "scheme": "regain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.saadelidrissiazami.regain",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.saadelidrissiazami.regain",
      "adaptiveIcon": {
        "backgroundColor": "#17483E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FAF8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#17483E"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Regain synchronise votre planning avec votre calendrier.",
          "remindersPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Regain utilise votre position pour proposer un itinéraire de marche et l'histoire de votre quartier.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-sharing",
      "./plugins/withIosSceneDelegate",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "description": "Regain aide à reconstruire une routine : un planning réaliste, des séances de bien-être guidées et un coach forme.",
    "primaryColor": "#17483E",
    "extra": {
      "eas": {
        "projectId": "1709f3ff-d7e0-4903-8701-fd76d1142bc8"
      }
    },
    "owner": "saadappregain",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1709f3ff-d7e0-4903-8701-fd76d1142bc8"
    }
  }
}
